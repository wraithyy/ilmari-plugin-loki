          "editorMode": "code",
          "expr": "count(max by (pid) (count_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json role=\"data.role\", pid=\"data.pid\" | role=\"run\" [$__interval])))",
          "legendFormat": "running tasks"
