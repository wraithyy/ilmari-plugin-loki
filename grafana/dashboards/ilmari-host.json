    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU load",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "range",
          "editorMode": "code",
          "expr": "max by (host) (max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.load1\" | unwrap v | __error__=\"\" [$__interval]))",
          "legendFormat": "{{host}} load (1m)"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "B",
          "queryType": "range",
          "editorMode": "code",
          "expr": "max(max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.cpus\" | unwrap v | __error__=\"\" [$__interval]))",
          "legendFormat": "cores"
        }
      ],
      "interval": "2m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "gradientMode": "none",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cores"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
