    {
      "id": 20,
      "type": "table",
      "title": "Heaviest task runs",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "topk(15, max by (task) (max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.rss\", task=\"data.task\" | unwrap v | __error__=\"\" [$__range])))",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "B",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "max by (task) (max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.processCpuPct\", task=\"data.task\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "C",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "max by (task) (max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.processUptimeSec\", task=\"data.task\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Peak memory and CPU of the process that ran each task. Click a task to open it.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Value #A",
                "config": {
                  "id": "isNotNull"
                }
              }
            ],
            "type": "include",
            "match": "all"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "task": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "task": "Task",
              "Value #A": "Peak memory",
              "Value #B": "Peak CPU",
              "Value #C": "Ran for"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Peak memory",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Task"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Task explorer",
                    "url": "/d/ilmari-task/ilmari-task-explorer?var-task=${__data.fields.task}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ran for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    }
