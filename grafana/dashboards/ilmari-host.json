          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "max(last_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.memUsedPct\" | unwrap v | __error__=\"\" [5m]))",
          "instant": true,
          "legendFormat": "Memory used"
        }
      ],
      "description": "Host memory in use. On macOS the OS counts file cache as used, so this reads high.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 92
