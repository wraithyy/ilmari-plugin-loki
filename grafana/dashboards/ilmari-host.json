            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "range",
          "editorMode": "code",
          "expr": "sum by (role) (max by (role, pid) (max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.rss\", role=\"data.role\", pid=\"data.pid\" | unwrap v | __error__=\"\" [$__interval])))",
          "legendFormat": "{{role}}"
        }
      ],
      "description": "Resident memory: the serve daemon vs. all task processes together (stacked).",
      "interval": "2m",
      "options": {
