          "queryType": "range",
          "editorMode": "code",
          "expr": "sum by (role) (max by (role, pid) (max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.processCpuPct\", role=\"data.role\", pid=\"data.pid\" | unwrap v | __error__=\"\" [$__interval])))",
          "legendFormat": "{{role}}"
        }
      ],
      "description": "Process CPU, 100% = one full core.",
