          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "max(max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.eventLoopLagMs\" | unwrap v | __error__=\"\" [5m]))",
          "instant": true,
          "legendFormat": "Event loop lag"
        }
      ],
      "description": "Worst p99 event loop delay of any ilmari process in the last 5 minutes; high values mean a blocked daemon.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
