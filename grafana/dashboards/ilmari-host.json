            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "count(max by (pid) (count_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json pid=\"data.pid\" [3m])))",
          "instant": true,
          "legendFormat": "ilmari processes"
        }
      ],
      "description": "The serve daemon plus one process per running task.",
      "options": {
        "reduceOptions": {
