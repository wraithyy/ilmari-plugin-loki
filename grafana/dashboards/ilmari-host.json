          "refId": "A",
          "queryType": "range",
          "editorMode": "code",
          "expr": "max(max_over_time({service_name=\"ilmari\", type=\"system\", host=~\"$host\"} | json v=\"data.load1\" | unwrap v | __error__=\"\" [$__interval]))",
          "legendFormat": "load (1m)"
