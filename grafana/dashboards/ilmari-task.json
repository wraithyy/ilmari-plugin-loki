        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Steps",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (node, model) (sum_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} |= \"$task\" | json task, v=\"data.costUsd\", model=\"data.model\", node=\"data.node\" | task=\"$task\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "B",
