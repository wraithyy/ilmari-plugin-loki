    {
      "id": 7,
      "type": "stat",
      "title": "Tool calls",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"tool_use\"} |= \"$task\" | json task | task=\"$task\" [$__range]))",
          "instant": true,
