{
  "uid": "ilmari-task",
  "title": "ilmari - Task explorer",
  "description": "One ilmari task: its steps, spend, verification, and the full agent transcript.",
  "tags": [
    "ilmari",
    "loki"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "refresh": 1
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "project",
          "stream": "{service_name=\"ilmari\"}",
          "type": 1,
          "label": "project"
        },
        "definition": "label_values({service_name=\"ilmari\"}, project)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "task",
        "label": "Task id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Task failures",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "{service_name=\"ilmari\", project=~\"$project\", type=\"task_failed\"} | json task, title, reason=\"data.reason\"",
        "target": {
          "refId": "Anno",
          "expr": "{service_name=\"ilmari\", project=~\"$project\", type=\"task_failed\"} | json task, title, reason=\"data.reason\""
        },
        "titleFormat": "Task failed: {{title}}",
        "textFormat": "{{reason}}",
        "filter": {
          "exclude": false,
          "ids": []
        }
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/ilmari-overview/ilmari-overview",
      "icon": "apps",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Host",
      "type": "link",
      "url": "/d/ilmari-host/ilmari-host",
      "icon": "bolt",
      "keepTime": true
    },
    {
      "title": "Logs Drilldown",
      "type": "link",
      "url": "/a/grafana-lokiexplore-app/explore/service/ilmari/logs",
      "icon": "external link",
      "keepTime": true,
      "tooltip": "Grafana's point-and-click log browser, pre-filtered to ilmari"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Pick a task",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (task, title, project) (sum_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} | json task, title, v=\"data.costUsd\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "B",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (task, title, project) (count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} | json task, title [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "C",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (task, title, project) (count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\", level=\"error\"} | json task, title [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "D",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (task, title, project) (count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"tool_use\"} | json task, title [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "E",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (task, title, project) (sum_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} | json task, title, v=\"data.durationMs\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "F",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (task, title, project) (count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"task_failed\"} | json task, title [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "G",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum by (task, title, project) (count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"mr_created\"} | json task, title [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "H",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "min by (task, title, project) (min_over_time({service_name=\"ilmari\", project=~\"$project\", type!=\"system\"} | json task, title, v=\"at\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "I",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "max by (task, title, project) (max_over_time({service_name=\"ilmari\", project=~\"$project\", type!=\"system\"} | json task, title, v=\"at\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "description": "Click a task to load it below, or paste an id into the Task id box.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "project": 0,
              "title": 1,
              "Value #F": 2,
              "Value #G": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "Value #E": 8,
              "task": 9
            },
            "renameByName": {
              "project": "Project",
              "title": "Task",
              "task": "Task id",
              "Value #A": "Spend",
              "Value #B": "Steps",
              "Value #C": "Failed steps",
              "Value #D": "Tool calls",
              "Value #E": "Agent time",
              "Value #F": "Outcome",
              "Value #G": "MR",
              "Value #H": "first",
              "Value #I": "last"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Task",
                "config": {
                  "id": "isNotNull"
                }
              }
            ],
            "type": "include",
            "match": "all"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Spend",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Task"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 340
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Task explorer",
                    "url": "/d/ilmari-task/ilmari-task-explorer?var-task=${__data.fields.task}&from=${__data.fields.first}&to=${__data.fields.last}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Task id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "first"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spend"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Agent time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed steps"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 1000000000,
                      "result": {
                        "text": "failed",
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "noValue",
                "value": ""
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MR"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 1000000000,
                      "result": {
                        "text": "opened",
                        "color": "green",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "noValue",
                "value": ""
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spend",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} |= \"$task\" | json task, v=\"data.costUsd\" | task=\"$task\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "legendFormat": "Spend"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Steps",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} |= \"$task\" | json task | task=\"$task\" [$__range]))",
          "instant": true,
          "legendFormat": "Steps"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed steps",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\", level=\"error\"} |= \"$task\" | json task | task=\"$task\" [$__range]))",
          "instant": true,
          "legendFormat": "Failed steps"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Agent time",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} |= \"$task\" | json task, v=\"data.durationMs\" | task=\"$task\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
          "legendFormat": "Agent time"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1f7a8c",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Output tokens",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
