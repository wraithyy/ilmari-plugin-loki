          },
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=\"ilmari\", project=~\"$project\", type=\"node_finished\"} |= \"$task\" | json task, v=\"data.usage.outputTokens\" | task=\"$task\" | unwrap v | __error__=\"\" [$__range]))",
          "instant": true,
